---
const path = Astro.url.pathname;
const onInvitation = path === '/' || path === '';
const onPhotos = path === '/photos' || path.startsWith('/photos/');
---

<ul class="site-nav">
  <li><a href="/" aria-current={onInvitation ? 'page' : undefined}>Invitation</a></li>
  <li><a href="/photos" aria-current={onPhotos ? 'page' : undefined}>Photos</a></li>
</ul>
