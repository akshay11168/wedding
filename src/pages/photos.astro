---
import Nav from '../components/Nav.astro';
import { site } from '../config';
import '../styles/site.css';

const open = site.photos === 'open';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Photos</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Outfit:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="photos-page">
    <Nav />
    <main>
      <h1>Photos</h1>
      {open ? <p>No pictures have been added yet.</p> : <p>Coming soon</p>}
    </main>
  </body>
</html>
